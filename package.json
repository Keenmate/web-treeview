{
  "name": "@keenmate/web-treeview",
  "version": "2.0.0-rc07",
  "description": "Lightweight treeview web component with hierarchical data display, search, expand/collapse, drag-drop, and keyboard navigation",
  "type": "module",
  "main": "./dist/web-treeview.umd.js",
  "module": "./dist/web-treeview.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/web-treeview.css",
  "customElements": "custom-elements.json",
  "web-types": "web-types.json",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/web-treeview.js",
      "require": "./dist/web-treeview.umd.js",
      "default": "./dist/web-treeview.js"
    },
    "./style.css": "./dist/web-treeview.css",
    "./css": "./src/css/main.css",
    "./dist/*": "./dist/*",
    "./src/css/*": "./src/css/*",
    "./package.json": "./package.json",
    "./component-variables.manifest.json": "./component-variables.manifest.json"
  },
  "sideEffects": [
    "./dist/web-treeview.js",
    "./dist/web-treeview.umd.js",
    "*.css"
  ],
  "files": [
    "dist",
    "src/css",
    "component-variables.manifest.json",
    "custom-elements.json",
    "web-types.json",
    "vscode.html-custom-data.json",
    "vscode.css-custom-data.json",
    "CHANGELOG.md"
  ],
  "kmwc": {
    "title": "Web TreeView",
    "tag": "web-treeview",
    "prefix": "wtv",
    "library": {
      "globalName": "WebTreeView",
      "fileName": "web-treeview",
      "cssFileName": "web-treeview",
      "shouldEmitSourcemap": true
    },
    "ports": {
      "dev": 12300,
      "image": 12310
    },
    "theme": {
      "accentColor": "#059669",
      "accentEndColor": "#065f46"
    },
    "examples": {
      "canonicalOrigin": "https://examples.web-treeview.keenmate.dev"
    },
    "analytics": {
      "plausibleSiteId": "pa-RDHwg8IIJaVGkQuUsM0t0"
    },
    "image": {
      "name": "registry.km8.es/web-treeview-examples:prod",
      "runner": "podman"
    }
  },
  "scripts": {
    "dev": "vite",
    "analyze": "cem analyze",
    "build:types": "tsc --noEmit",
    "check:contract": "base-contract-check src docs test README.md",
    "build": "npm run clean:dist && npm run check:contract && npm run analyze && vite build",
    "preview": "vite preview",
    "package": "npm run build && npm pack",
    "clean": "rimraf dist dist-examples --glob \"*.tgz\"",
    "clean:dist": "rimraf dist",
    "prepublishOnly": "npm run build",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "playwright test --workers=4",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "build:examples": "vite build --mode examples",
    "preview:examples": "vite preview --mode examples",
    "doctor": "kmwc doctor",
    "check:vars": "kmwc check-vars",
    "check:pages": "kmwc check-pages"
  },
  "keywords": [
    "web-component",
    "custom-element",
    "custom-elements",
    "web-components",
    "treeview",
    "tree",
    "hierarchical",
    "ltree",
    "drag-drop",
    "search",
    "framework-agnostic",
    "shadow-dom",
    "typescript",
    "keenmate"
  ],
  "author": "KeenMate",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KeenMate/web-treeview.git"
  },
  "homepage": "https://github.com/KeenMate/web-treeview#readme",
  "bugs": {
    "url": "https://github.com/KeenMate/web-treeview/issues"
  },
  "dependencies": {
    "@keenmate/web-components-core": "^1.0.0-rc17",
    "flexsearch": "^0.8.212"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@keenmate/base-css-variables": "^2.0.0-rc08",
    "@keenmate/web-components-devkit": "^1.0.0-rc09",
    "@playwright/test": "^1.61.0",
    "@types/node": "^24.3.1",
    "custom-element-jet-brains-integration": "^1.7.0",
    "custom-element-vs-code-integration": "^1.5.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vite-plugin-dts": "^4.5.4"
  }
}
