{
  "$schema": "https://raw.githubusercontent.com/keenmate/schemas/main/component-variables.schema.json",
  "component": "@keenmate/web-treeview",
  "prefix": "wtv",
  "baseVariables": [
    { "name": "base-rem", "required": false, "usage": "Base sizing unit (default: 10px)" },
    { "name": "base-accent-color", "required": true, "usage": "Selected nodes, context menu accents, scroll highlight, empty zone" },
    { "name": "base-accent-color-hover", "required": false, "usage": "Accent hover state" },
    { "name": "base-accent-color-light", "required": false, "usage": "Selected node background" },
    { "name": "base-text-color-1", "required": true, "usage": "Primary text (node labels, context menu items)" },
    { "name": "base-text-color-3", "required": false, "usage": "Secondary text (node paths, toggle icons, divider labels)" },
    { "name": "base-text-color-on-accent", "required": false, "usage": "Text on accent backgrounds (drag ghost)" },
    { "name": "base-main-bg", "required": true, "usage": "Tree background, context menu background" },
    { "name": "base-elevated-bg", "required": false, "usage": "Elevated surface background (debug stats badges)" },
    { "name": "base-hover-bg", "required": false, "usage": "Node hover background, context menu item hover" },
    { "name": "base-active-bg", "required": false, "usage": "Node active/pressed background" },
    { "name": "base-border-color", "required": true, "usage": "Context menu border, dividers, debug info border, spinner track" },
    { "name": "base-success-color", "required": false, "usage": "Valid drop indicator, dragover highlight" },
    { "name": "base-danger-color", "required": false, "usage": "Invalid drop indicator, context menu danger items" },
    { "name": "base-font-family", "required": false, "usage": "All text in component" },
    { "name": "base-font-size-xs", "required": false, "usage": "Toggle icons, node paths, debug info (multiplier)" },
    { "name": "base-font-size-sm", "required": false, "usage": "Node labels, context menu items (multiplier)" },
    { "name": "base-font-size-base", "required": false, "usage": "Base text size (multiplier)" },
    { "name": "base-font-weight-medium", "required": false, "usage": "Node label weight" },
    { "name": "base-font-weight-semibold", "required": false, "usage": "Debug info headers, drop zone labels" },
    { "name": "base-border-radius-sm", "required": false, "usage": "Selected node borders (multiplier)" },
    { "name": "base-border-radius-md", "required": false, "usage": "Medium radius (multiplier)" },
    { "name": "base-border-radius-lg", "required": false, "usage": "Context menu, empty zone radius (multiplier)" },
    { "name": "base-icon-chevron", "required": false, "usage": "Default disclosure glyph (icon-set=chevron) — mask-image" },
    { "name": "base-icon-caret-down", "required": false, "usage": "Triangle disclosure glyph (icon-set=triangle) — mask-image" },
    { "name": "base-icon-expand", "required": false, "usage": "Plus disclosure glyph (icon-set=plus-minus) — mask-image" },
    { "name": "base-icon-collapse", "required": false, "usage": "Minus disclosure glyph (icon-set=plus-minus) — mask-image" },
    { "name": "base-icon-check", "required": false, "usage": "Checkbox checkmark glyph; chained by --wtv-icon-check — mask-image" },
    { "name": "base-icon-indeterminate", "required": false, "usage": "Tri-state (partial) checkbox dash glyph; chained by --wtv-icon-indeterminate — mask-image" }
  ],
  "componentVariables": [
    { "name": "wtv-rem", "category": "sizing", "usage": "Base sizing unit for proportional scaling (default: 10px)" },

    { "name": "wtv-spacing-xs", "category": "spacing", "usage": "Extra small spacing (2px)" },
    { "name": "wtv-spacing-sm", "category": "spacing", "usage": "Small spacing (4px)" },
    { "name": "wtv-spacing-md", "category": "spacing", "usage": "Medium spacing (8px)" },
    { "name": "wtv-spacing-lg", "category": "spacing", "usage": "Large spacing (12px)" },
    { "name": "wtv-spacing-xl", "category": "spacing", "usage": "Extra large spacing (16px)" },

    { "name": "wtv-font-family", "category": "typography", "usage": "Component font family (overrides --base-font-family)" },
    { "name": "wtv-font-size-xs", "category": "typography", "usage": "Extra small font (12px)" },
    { "name": "wtv-font-size-sm", "category": "typography", "usage": "Small font (14px)" },
    { "name": "wtv-font-size-base", "category": "typography", "usage": "Base font (16px)" },
    { "name": "wtv-font-size", "category": "typography", "usage": "Default font size (= tv-font-size-sm)" },
    { "name": "wtv-font-weight-medium", "category": "typography", "usage": "Medium font weight" },
    { "name": "wtv-font-weight-semibold", "category": "typography", "usage": "Semibold font weight" },

    { "name": "wtv-accent-color", "category": "color", "usage": "Primary accent color" },
    { "name": "wtv-accent-color-hover", "category": "color", "usage": "Accent color on hover" },
    { "name": "wtv-text-color", "category": "color", "usage": "Primary text color" },
    { "name": "wtv-text-color-2", "category": "color", "usage": "Secondary/muted text color" },
    { "name": "wtv-text-color-on-accent", "category": "color", "usage": "Text on accent backgrounds" },
    { "name": "wtv-bg-color", "category": "surface", "usage": "Main background color" },
    { "name": "wtv-border-color", "category": "border", "usage": "Default border color" },
    { "name": "wtv-success-color", "category": "color", "usage": "Success/valid drop color" },
    { "name": "wtv-danger-color", "category": "color", "usage": "Danger/invalid drop color" },
    { "name": "wtv-light-bg", "category": "surface", "usage": "Elevated/subtle surface background" },
    { "name": "wtv-hover-bg", "category": "surface", "usage": "Hover background" },
    { "name": "wtv-active-bg", "category": "surface", "usage": "Active/pressed background" },
    { "name": "wtv-selected-bg", "category": "surface", "usage": "Selected node background" },
    { "name": "wtv-selected-border-color", "category": "border", "usage": "Selected node border color" },
    { "name": "wtv-selected-border", "category": "border", "usage": "Selected node border shorthand (2px solid accent)" },
    { "name": "wtv-border-width-base", "category": "border", "usage": "Base border width (1px)" },
    { "name": "wtv-border", "category": "border", "usage": "Full border shorthand (1px solid border-color)" },
    { "name": "wtv-node-bg-hover", "category": "surface", "usage": "Node hover background (aliases tv-hover-bg)" },
    { "name": "wtv-node-bg-active", "category": "surface", "usage": "Node active/pressed background (aliases tv-active-bg)" },
    { "name": "wtv-node-transition", "category": "tree", "usage": "Node content transition (set to 'none' to disable hover animation)" },

    { "name": "wtv-border-radius-sm", "category": "border", "usage": "Small border radius (4px)" },
    { "name": "wtv-border-radius-md", "category": "border", "usage": "Medium border radius (6px)" },
    { "name": "wtv-border-radius-lg", "category": "border", "usage": "Large border radius (8px)" },

    { "name": "wtv-transition-speed", "category": "animation", "usage": "Fast transition duration (150ms)" },
    { "name": "wtv-transition-normal", "category": "animation", "usage": "Normal transition duration (200ms)" },
    { "name": "wtv-easing", "category": "animation", "usage": "Default easing curve" },

    { "name": "wtv-column-width", "category": "tree", "usage": "Unified column width for toggle, icon, and indent step (24px)" },
    { "name": "wtv-indent-size", "category": "tree", "usage": "Tree node indent per level (= tv-column-width)" },
    { "name": "wtv-node-padding", "category": "tree", "usage": "Node content padding" },
    { "name": "wtv-node-height", "category": "tree", "usage": "Node row height (32px)" },
    { "name": "wtv-icon-size", "category": "tree", "usage": "Node icon size (16px)" },
    { "name": "wtv-toggle-size", "category": "tree", "usage": "Toggle icon column size (= tv-column-width)" },
    { "name": "wtv-toggle-color", "category": "tree", "usage": "Toggle icon color" },
    { "name": "wtv-icon-expand", "category": "tree", "usage": "Disclosure glyph mask (collapsed / the only glyph in rotate mode); chained to --base-icon-chevron. Re-pointed per icon-set." },
    { "name": "wtv-icon-collapse", "category": "tree", "usage": "Disclosure glyph mask shown when expanded (swap mode only); chained to --base-icon-collapse for the plus-minus set." },
    { "name": "wtv-icon-leaf", "category": "tree", "usage": "Optional leaf marker glyph mask (opt-in via leafIconClass=wtv__toggle-icon--leaf)." },
    { "name": "wtv-icon-rotate-collapsed", "category": "tree", "usage": "Collapsed-state rotation for the disclosure glyph (0deg for a right-pointing chevron, -90deg for a down-caret)." },
    { "name": "wtv-icon-rotate-expanded", "category": "tree", "usage": "Expanded-state rotation for the disclosure glyph (90deg for chevron)." },
    { "name": "wtv-icon-size-glyph", "category": "tree", "usage": "Disclosure glyph mask box size (default 1em)." },
    { "name": "wtv-icon-check", "category": "checkbox", "usage": "Checkmark glyph (mask) for a checked checkbox; chains to --base-icon-check." },
    { "name": "wtv-icon-indeterminate", "category": "checkbox", "usage": "Dash glyph (mask) for a tri-state/partial checkbox; chains to --base-icon-indeterminate." },
    { "name": "wtv-checkbox-size", "category": "checkbox", "usage": "Checkbox box dimension (default 1.6×rem)." },
    { "name": "wtv-checkbox-border-width", "category": "checkbox", "usage": "Checkbox box border thickness (hairline, does not scale)." },
    { "name": "wtv-checkbox-border-color", "category": "checkbox", "usage": "Unchecked checkbox box border color." },
    { "name": "wtv-checkbox-bg", "category": "checkbox", "usage": "Unchecked checkbox box background." },
    { "name": "wtv-checkbox-checked-bg", "category": "checkbox", "usage": "Checked / indeterminate checkbox box background (defaults to the accent color)." },
    { "name": "wtv-checkbox-checked-border-color", "category": "checkbox", "usage": "Checked / indeterminate checkbox box border color." },
    { "name": "wtv-checkbox-checkmark-color", "category": "checkbox", "usage": "Check / dash glyph color (tints the mask)." },

    { "name": "wtv-glow-before-color", "category": "dnd", "usage": "Drop-before glow indicator color" },
    { "name": "wtv-glow-after-color", "category": "dnd", "usage": "Drop-after glow indicator color" },
    { "name": "wtv-glow-child-color", "category": "dnd", "usage": "Drop-as-child glow indicator color" },
    { "name": "wtv-glow-before-bg", "category": "dnd", "usage": "Drop-before zone background" },
    { "name": "wtv-glow-after-bg", "category": "dnd", "usage": "Drop-after zone background" },
    { "name": "wtv-glow-child-bg", "category": "dnd", "usage": "Drop-as-child zone background" },
    { "name": "wtv-glow-before-bg-active", "category": "dnd", "usage": "Drop-before zone active background" },
    { "name": "wtv-glow-after-bg-active", "category": "dnd", "usage": "Drop-after zone active background" },
    { "name": "wtv-glow-child-bg-active", "category": "dnd", "usage": "Drop-as-child zone active background" },
    { "name": "wtv-glow-before-color-active", "category": "dnd", "usage": "Drop-before zone active text color" },
    { "name": "wtv-glow-after-color-active", "category": "dnd", "usage": "Drop-after zone active text color" },
    { "name": "wtv-glow-child-color-active", "category": "dnd", "usage": "Drop-as-child zone active text color" },
    { "name": "wtv-glow-before-shadow", "category": "dnd", "usage": "Drop-before zone active box shadow" },
    { "name": "wtv-glow-after-shadow", "category": "dnd", "usage": "Drop-after zone active box shadow" },
    { "name": "wtv-glow-child-shadow", "category": "dnd", "usage": "Drop-as-child zone active box shadow" },
    { "name": "wtv-glow-before-text", "category": "dnd", "usage": "Drop-before zone default text color" },
    { "name": "wtv-glow-after-text", "category": "dnd", "usage": "Drop-after zone default text color" },
    { "name": "wtv-glow-child-text", "category": "dnd", "usage": "Drop-as-child zone default text color" },
    { "name": "wtv-drag-over-bg", "category": "dnd", "usage": "Drag-over node background" },
    { "name": "wtv-drag-over-border", "category": "dnd", "usage": "Drag-over node border" },
    { "name": "wtv-drag-over-glow-shadow", "category": "dnd", "usage": "Drag-over glow box shadow" },
    { "name": "wtv-drop-valid-bg", "category": "dnd", "usage": "Valid drop target background" },
    { "name": "wtv-drop-valid-border-color", "category": "dnd", "usage": "Valid drop target border color" },
    { "name": "wtv-drop-invalid-bg", "category": "dnd", "usage": "Invalid drop target background" },
    { "name": "wtv-drop-invalid-border-color", "category": "dnd", "usage": "Invalid drop target border color" },
    { "name": "wtv-dragover-highlight-bg", "category": "dnd", "usage": "Dragover highlight background" },
    { "name": "wtv-dragover-highlight-border", "category": "dnd", "usage": "Dragover highlight border" },
    { "name": "wtv-touch-ghost-bg", "category": "dnd", "usage": "Touch drag ghost background" },
    { "name": "wtv-touch-ghost-shadow", "category": "dnd", "usage": "Touch drag ghost box shadow" },
    { "name": "wtv-scroll-highlight-bg", "category": "dnd", "usage": "Scroll-to-node highlight background" },
    { "name": "wtv-scroll-highlight-shadow", "category": "dnd", "usage": "Scroll-to-node highlight box shadow" },
    { "name": "wtv-dragged-opacity", "category": "dnd", "usage": "Opacity of dragged node (0.5)" },
    { "name": "wtv-cut-opacity", "category": "dnd", "usage": "Opacity of cut nodes pending paste (0.4)" },

    { "name": "wtv-context-menu-bg", "category": "context-menu", "usage": "Context menu background" },
    { "name": "wtv-context-menu-bg-hover", "category": "context-menu", "usage": "Context menu item hover background" },
    { "name": "wtv-context-menu-text-color", "category": "context-menu", "usage": "Context menu text color" },
    { "name": "wtv-context-menu-border", "category": "context-menu", "usage": "Context menu border" },
    { "name": "wtv-context-menu-border-radius", "category": "context-menu", "usage": "Context menu border radius" },
    { "name": "wtv-context-menu-shadow", "category": "context-menu", "usage": "Context menu box shadow" },
    { "name": "wtv-context-menu-min-width", "category": "context-menu", "usage": "Context menu minimum width (~150px)" },
    { "name": "wtv-context-menu-padding", "category": "context-menu", "usage": "Context menu padding" },
    { "name": "wtv-context-menu-font-size", "category": "context-menu", "usage": "Context menu font size" },
    { "name": "wtv-context-menu-item-padding", "category": "context-menu", "usage": "Context menu item padding" },
    { "name": "wtv-context-menu-item-gap", "category": "context-menu", "usage": "Gap between icon, label, shortcut" },
    { "name": "wtv-context-menu-icon-width", "category": "context-menu", "usage": "Icon column width in context menu" },
    { "name": "wtv-context-menu-icon-font-size", "category": "context-menu", "usage": "Icon font size in context menu" },
    { "name": "wtv-context-menu-arrow-font-size", "category": "context-menu", "usage": "Submenu arrow font size" },
    { "name": "wtv-context-menu-danger-color", "category": "context-menu", "usage": "Danger item text color" },
    { "name": "wtv-context-menu-danger-bg-hover", "category": "context-menu", "usage": "Danger item hover background" },
    { "name": "wtv-context-menu-divider-color", "category": "context-menu", "usage": "Divider line color" },
    { "name": "wtv-context-menu-divider-margin", "category": "context-menu", "usage": "Divider margin" },
    { "name": "wtv-context-menu-disabled-opacity", "category": "context-menu", "usage": "Disabled item opacity" },

    { "name": "wtv-spinner-size", "category": "loading", "usage": "Loading spinner size (32px)" },
    { "name": "wtv-spinner-track", "category": "loading", "usage": "Spinner track color" },
    { "name": "wtv-spinner-color", "category": "loading", "usage": "Spinner accent color" },
    { "name": "wtv-loading-bg", "category": "loading", "usage": "Loading overlay background" },

    { "name": "wtv-tree-min-height", "category": "empty", "usage": "Min height for empty and loading states (60px)" },
    { "name": "wtv-empty-zone-border", "category": "empty", "usage": "Empty tree drop zone border" },
    { "name": "wtv-empty-zone-bg", "category": "empty", "usage": "Empty tree drop zone background" },
    { "name": "wtv-empty-zone-radius", "category": "empty", "usage": "Empty tree drop zone border radius" },

    { "name": "wtv-z-index-dropdown", "category": "z-index", "usage": "Context menu z-index (1000)" },
    { "name": "wtv-z-index-ghost", "category": "z-index", "usage": "Drag ghost z-index (10000)" },
    { "name": "wtv-z-index-overlay", "category": "z-index", "usage": "Loading overlay z-index (10)" }
  ]
}
